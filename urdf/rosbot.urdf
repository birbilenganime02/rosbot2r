<?xml version="1.0"?>
<robot name="ROSBOT2R">
  <link name="base_link">
    <inertial>
      <origin xyz="0.015 0.0 0.0" rpy="0 0 0" />
      <mass value="3.5" />
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.045" iyz="0.0" izz="0.055" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///root/rosbot2r/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.015 0.0 0.02" rpy="0 0 0" />
      <geometry>
        <box size="0.22 0.16 0.06" />
      </geometry>
    </collision>
  </link>

  <link name="Link-BR">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0007" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///root/rosbot2r/meshes/Link-BR.STL" />
      </geometry>
      <material name=""><color rgba="1 1 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0505" length="0.035" />
      </geometry>
    </collision>
  </link>
  <joint name="joint-BR" type="continuous">
    <origin xyz="-0.070 -0.147 -0.0908" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Link-BR" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="Link-FR">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0007" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///root/rosbot2r/meshes/Link-FR.STL" />
      </geometry>
      <material name=""><color rgba="1 1 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0505" length="0.035" />
      </geometry>
    </collision>
  </link>
  <joint name="joint-FR" type="continuous">
    <origin xyz="0.100 -0.147 -0.0908" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Link-FR" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="Link-BL">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0007" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///root/rosbot2r/meshes/Link-BL.STL" />
      </geometry>
      <material name=""><color rgba="1 1 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0505" length="0.035" />
      </geometry>
    </collision>
  </link>
  <joint name="joint-BL" type="continuous">
    <origin xyz="-0.070 0.147 -0.0908" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Link-BL" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="Link-FL">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
      <mass value="0.5" />
      <inertia ixx="0.0007" ixy="0" ixz="0" iyy="0.0012" iyz="0" izz="0.0007" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="file:///root/rosbot2r/meshes/Link-FL.STL" />
      </geometry>
      <material name=""><color rgba="1 1 1 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.0505" length="0.035" />
      </geometry>
    </collision>
  </link>
  <joint name="joint-FL" type="continuous">
    <origin xyz="0.100 0.147 -0.0908" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="Link-FL" />
    <axis xyz="0 1 0" />
  </joint>

  
  <link name="rear_part">
    <visual>
      <origin xyz="-0.065 0.0 0.015" rpy="0 0 0" />
      <geometry>
        <box size="0.09 0.165 0.065" />
      </geometry>
    </visual>
  </link>
  <joint name="joint_rear_part" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="rear_part" />
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0.035 0.0 0.055" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.0505" length="0.03" />
      </geometry>
    </visual>
  </link>
  <joint name="joint_lidar" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="lidar_link" />
  </joint>

  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <num_wheel_pairs>1</num_wheel_pairs>
      <left_joint>joint-BL</left_joint>
      <right_joint>joint-BR</right_joint>
      <wheel_separation>0.294</wheel_separation>
      <wheel_diameter>0.104</wheel_diameter>
      <max_wheel_torque>10.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="rear_part">
    <visual>
      <material>
        <ambient>0.96 0.92 0.80 1</ambient>
        <diffuse>0.96 0.92 0.80 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="lidar_link"><material>Gazebo/FlatBlack</material></gazebo>

  <gazebo reference="Link-FL">
    <material>Gazebo/FlatBlack</material>
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
  </gazebo>
  <gazebo reference="Link-FR">
    <material>Gazebo/FlatBlack</material>
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
  </gazebo>
  <gazebo reference="Link-BL">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="Link-BR">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
</robot>
