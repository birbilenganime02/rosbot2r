<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) 1. Yürüyen İnsan (İleri-Geri Devriye) -->
    <actor name="hareketli_insan_1">
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>2 1 0 0 0 0</pose></waypoint>
          <waypoint><time>4</time><pose>4 1 0 0 0 0</pose></waypoint>
          <waypoint><time>5</time><pose>4 1 0 0 0 3.14</pose></waypoint>
          <waypoint><time>9</time><pose>2 1 0 0 0 3.14</pose></waypoint>
          <waypoint><time>10</time><pose>2 1 0 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) 2. Yürüyen İnsan (Çapraz Hat) -->
    <actor name="hareketli_insan_2">
      <skin>
        <filename>walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>1.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>3 -2 0 0 0 1.57</pose></waypoint>
          <waypoint><time>5</time><pose>3 2 0 0 0 1.57</pose></waypoint>
          <waypoint><time>6</time><pose>3 2 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>11</time><pose>3 -2 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>12</time><pose>3 -2 0 0 0 1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) Çevre Engelleri ve Sabit İnsan Modeli -->
    <model name="cevre_engelleri">
      <static>true</static>
      
      <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) Varil 1 -->
      <link name="varil_1">
        <pose>1.5 -1.2 0.45 0 0 0</pose>
        <collision name="c1"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v1"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry><material><ambient>0.8 0.4 0.1 1</ambient></material></visual>
      </link>

      <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) Varil 2 -->
      <link name="varil_2">
        <pose>1.5 -1.8 0.45 0 0 0</pose>
        <collision name="c2"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v2"><geometry><cylinder><radius>0.3</radius><length>0.9</length></cylinder></geometry><material><ambient>0.8 0.4 0.1 1</ambient></material></visual>
      </link>

      <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) Kutu 1 -->
      <link name="kutu_1">
        <pose>2.5 3.0 0.5 0 0 0.3</pose>
        <collision name="c3"><geometry><box><size>0.8 1.2 1.0</size></box></geometry></collision>
        <visual name="v3"><geometry><box><size>0.8 1.2 1.0</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>

      <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) Sabit Duran İnsan -->
      <link name="sabit_kisi_govde">
        <pose>4.5 -1.0 0.85 0 0 0</pose>
        <collision name="c4"><geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v4"><geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry><material><ambient>0.1 0.7 0.2 1</ambient></material></visual>
      </link>
      <link name="sabit_kisi_bas">
        <pose>4.5 -1.0 1.5 0 0 0</pose>
        <visual name="v5"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><ambient>0.9 0.7 0.6 1</ambient></material></visual>
      </link>
    </model>

  </world>
</sdf>
