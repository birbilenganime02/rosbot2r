      </link>

      <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) 3. İNSAN (Yeşil T-shirt - Sağ Çapraz) -->
      <link name="insan_3_govde">
        <pose>1.8 -1.5 0.85 0 0 0</pose>
