<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="kalabalik_insanlar">
      <static>true</static>

      <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) 1. İNSAN (Kırmızı T-shirt - Karşıda 2m) -->
      <link name="insan_1_govde">
        <pose>2.0 0.0 0.85 0 0 0</pose>
        <collision name="c1"><geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry></collision>
        <visual name="v1"><geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry><material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      </link>
      <link name="insan_1_bas">
        <pose>2.0 0.0 1.5 0 0 0</pose>
        <visual name="vb1"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><ambient>0.9 0.7 0.6 1</ambient><diffuse>0.9 0.7 0.6 1</diffuse></material></visual>
      </link>

      <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) 2. İNSAN (Mavi T-shirt - Sol Çapraz) -->
      <link name="insan_2_govde">
        <pose>1.8 1.5 0.85 0 0 0</pose>
        <collision name="c2"><geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry></collision>
