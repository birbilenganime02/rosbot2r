      </link>

      <- : Şasi ve tekerleklere ait STL çizimleri ( ,  ) 4. İNSAN (Sarı T-shirt - İleri Sol) -->
      <link name="insan_4_govde">
        <pose>3.5 1.0 0.85 0 0 0</pose>
